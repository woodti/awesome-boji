---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const steps = [
  {
    title: '弄清目标，放下速成预期',
    text: '先了解薄肌是什么。把“像某张照片”换成“建立一个能重复执行的习惯”，根据自己的起点开始。',
    link: '/guides/what-is-lean-muscle/',
    label: '先认识薄肌',
    time: '阅读约 4 分钟',
  },
  {
    title: '安排第一周，不排满整个月',
    text: '挑选两个不连续的日子，根据现有器械生成入门模板。第一次用轻阻力熟悉动作，先完成，再逐步调整。',
    link: '/plan/',
    label: '生成第一周计划',
    time: '安排约 2 分钟',
  },
  {
    title: '把动作练稳，把表现记下来',
    text: '查看动作要点和更容易的版本。训练时记录动作、阻力和次数，不用酸痛程度给自己打分。',
    link: '/movements/',
    label: '打开动作库',
    time: '练前随时查看',
  },
  {
    title: '吃好、恢复好，让下周接得上',
    text: '看懂蛋白质与热量估算。保持规律吃饭和恢复，不因为追求线条而盲目节食。',
    link: '/guides/protein-basics/',
    label: '看懂饮食基础',
    time: '阅读约 5 分钟',
  },
];
---

<Base
  title="薄肌新手从哪里开始？四步入门路径｜Awesome Boji"
  description="零基础薄肌入门路径：认识目标、安排第一周、掌握动作、理解饮食与恢复。从适合自己的条件开始训练。"
>
  <div class="wrap page-heading">
    <h1>
      薄肌怎么练，
      <br />
      从第一周开始。
    </h1>
    <p>不用一口气懂完所有知识。沿着这条路径，先把第一周安排好。</p>
  </div>
  <section class="wrap section-sm" style="padding-top:0">
    <div class="journey-list">
      {steps.map((step) => (
        <article class="journey-card">
          <div>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
            <a class="text-link" href={step.link}>
              {step.label}
              <Icon size={17} />
            </a>
          </div>
          <span class="tag">{step.time}</span>
        </article>
      ))}
    </div>
    <div class="notice" style="margin-top:30px;max-width:950px">
      这里的路径和模板面向一般健康成年人。已有伤病、运动时明显不适或特殊身体情况，请先确认适合自己的活动方式。
    </div>
  </section>
</Base>
