---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GuideCard from '../components/GuideCard.astro';
import { guides } from '../data/guides';
const featured = ['what-is-lean-muscle', 'beginner-first-week', 'protein-basics'].map((slug) =>
  guides.find((g) => g.slug === slug)!,
);
---

<Base>
  <section class="hero wrap">
    <div class="hero-copy reveal">
      <div class="eyebrow">给想开始的你 · 一份薄肌行动指南</div>
      <h1>
        练一点，
        <br />
        <span class="highlight">好一点。</span>
      </h1>
      <p class="hero-intro">
        不用把生活全部交给健身。
        <br />
        从看懂薄肌，到完成今天的一次训练，
        <br />
        找到适合自己的节奏，慢慢变强。
      </p>
      <div class="hero-actions">
        <a class="button" href="/start/">
          找到我的第一步 <Icon name="arrow" size={18} />
        </a>
        <a class="button secondary" href="/plan/">
          生成训练计划 <Icon name="plus" size={17} />
        </a>
      </div>
      <div class="hero-footnote">
        <Icon name="check" size={15} />
        <span>免费使用</span>
        <span>·</span>
        <span>无需注册</span>
        <span>·</span>
        <span>从自己的起点出发</span>
      </div>
    </div>
    <div class="hero-art reveal reveal-delay">
      <img
        src="/images/athlete.svg"
        width="720"
        height="860"
        alt="原创运动插画：深绿背景下，一位穿着浅色训练服的运动者正在迈步，身后是荧光黄圆形。"
        fetchpriority="high"
      />
      <div class="hero-caption">
        <small>A LITTLE, EVERY DAY.</small>
        <strong>先开始，再慢慢来。</strong>
        <span>你的节奏，就是好节奏。</span>
      </div>
    </div>
  </section>
  <div class="manifesto-strip">
    <div class="manifesto-inner wrap">
      <span class="manifesto-title">LESS HYPE. MORE ACTION.</span>
      <div>
        <Icon name="book" size={17} />
        <span>知识有出处</span>
        <small>KNOW THE WHY</small>
      </div>
      <div>
        <Icon name="barbell" size={19} />
        <span>训练有路径</span>
        <small>FIND YOUR WAY</small>
      </div>
      <div>
        <Icon name="sun" size={18} />
        <span>进步不着急</span>
        <small>KEEP IT GOING</small>
      </div>
    </div>
  </div>
  <section class="section wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">YOUR FIRST STEP</div>
        <h2>你现在，走到哪一步？</h2>
      </div>
      <a class="text-link" href="/start/">
        查看入门路径 <Icon size={17} />
      </a>
    </div>
    <div class="start-grid">
      <a class="start-card featured" href="/guides/what-is-lean-muscle/">
        <div class="step-top">
          <span class="step-number">01</span>
          <Icon name="book" size={23} />
        </div>
        <h3>先看懂，再开始</h3>
        <p>薄肌到底是什么？用几分钟弄清目标，少一点身材焦虑。</p>
        <div class="card-bottom">
          <span>认识薄肌</span>
          <Icon name="diagonal" />
        </div>
      </a>
      <a class="start-card" href="/plan/">
        <div class="step-top">
          <span class="step-number">02</span>
          <Icon name="barbell" size={25} />
        </div>
        <h3>找到能坚持的练法</h3>
        <p>居家也好，健身房也好。从你有的时间和器械开始安排。</p>
        <div class="card-bottom">
          <span>安排我的训练</span>
          <Icon name="diagonal" />
        </div>
      </a>
      <a class="start-card" href="/guides/protein-basics/">
        <div class="step-top">
          <span class="step-number">03</span>
          <Icon name="sun" size={24} />
        </div>
        <h3>吃好，也休息好</h3>
        <p>把训练放回生活。看懂饮食和恢复，让下周还能继续。</p>
        <div class="card-bottom">
          <span>了解饮食恢复</span>
          <Icon name="diagonal" />
        </div>
      </a>
    </div>
  </section>
  <section class="section-sm wrap" style="padding-top:0">
    <div class="section-head">
      <div>
        <div class="eyebrow">THE ESSENTIALS</div>
        <h2>先读这几篇，就够开始。</h2>
      </div>
      <a class="text-link" href="/guides/">
        所有指南 <Icon size={17} />
      </a>
    </div>
    <div class="guide-grid">
      {featured.map((guide) => (
        <GuideCard guide={guide} visual />
      ))}
    </div>
  </section>
  <section class="section wrap">
    <div class="tools-promo">
      <div>
        <div class="eyebrow" style="color:var(--lime)">
          SMALL TOOLS, CLEARER STEPS
        </div>
        <h2>
          少一点猜测，
          <br />
          多一点心里有数。
        </h2>
        <p>一天大概消耗多少热量？蛋白质怎么估算？用简单的工具，把抽象数字变成看得懂的参考。</p>
        <a class="button lime" href="/tools/">
          打开实用工具 <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="tools-preview" aria-label="蛋白质计算示例：体重70公斤，参考范围每天98至140克">
        <div class="preview-head">
          <span>每日蛋白质参考</span>
          <Icon name="calculator" size={18} />
        </div>
        <div class="preview-weight">
          70 <small>kg / 体重示例</small>
        </div>
        <div class="preview-track"></div>
        <div class="preview-output">
          <span>参考范围 / 每天</span>
          <strong>
            98–140 <small>g</small>
          </strong>
        </div>
        <p>健康成年运动者参考范围 · 结果因人而异</p>
      </div>
    </div>
  </section>
  <section class="section-sm wrap">
    <div class="faq-grid">
      <div>
        <div class="eyebrow">A FEW GOOD QUESTIONS</div>
        <h2>
          开始前，
          <br />
          你可能也想问。
        </h2>
        <p>把常见的困惑，先放下来。</p>
        <a class="text-link" href="/about/" style="margin-top:22px">
          了解我们的编辑原则 <Icon size={17} />
        </a>
      </div>
      <div class="faq-list">
        <details>
          <summary>薄肌是一套特定的训练方法吗？</summary>
          <p>
            “薄肌”通常是对身材外观的描述，没有统一的医学定义。本站从一般训练原则出发，帮助你建立练习习惯，不把某个热词当成适合所有人的训练处方。
          </p>
        </details>
        <details>
          <summary>零基础、没有健身卡，可以开始吗？</summary>
          <p>
            可以从安全、可控的徒手动作开始。计划生成器提供纯徒手、弹力带、哑铃和健身房版本。纯徒手版有动作覆盖限制，页面会说明；也可以先浏览动作库，找到更容易的变式。
          </p>
        </details>
        <details>
          <summary>多长时间能练成薄肌？</summary>
          <p>
            没有对所有人都成立的时间表。起点、身体差异、训练、饮食和恢复都会影响结果。先把目标设成规律完成训练、动作更稳和表现逐步提高，比承诺几周改变身材更实在。
          </p>
        </details>
        <details>
          <summary>这里和“薄肌理论”的创作者有关吗？</summary>
          <p>
            没有。练薄肌是独立内容项目。理论观察栏目会链接原始公开内容，区分创作者观点、本站解读和训练资料，不代表相关人物的授权或背书。
          </p>
        </details>
      </div>
    </div>
  </section>
  <div class="wrap section-sm">
    <div class="bottom-cta">
      <div>
        <h2>下一步，不用很大。</h2>
        <p>给这周留两个时间，从一次可控的训练开始。</p>
      </div>
      <a class="button" href="/plan/">
        安排我的第一周 <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</Base>
