---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { movements } from '../data/movements';
import { generatePlan } from '../lib/fitness.mjs';
const initial = generatePlan({ days: 2, equipment: 'home', duration: 35 });
const weekdays = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
---

<Base
  title="薄肌训练计划生成器｜居家、哑铃与健身房入门课表｜Awesome Boji"
  description="按每周两次或三次、器械条件和训练时长生成第一周入门训练模板。包含动作要点、休息安排、下载与打印功能。"
>
  <div class="wrap page-heading">
    <h1>把训练，放进你的生活。</h1>
    <p>不需要每天有空。选好时间和器械条件，生成一份可以开始的第一周模板。</p>
  </div>
  <section class="wrap section-sm" style="padding-top:0">
    <div class="planner-layout">
      <form id="plan-form" class="panel planner-controls">
        <h2 style="font-size:18px;margin-bottom:25px">从你已有的条件开始</h2>
        <fieldset>
          <legend>每周练几次？</legend>
          <div class="choice-grid">
            {[
              { value: 2, label: '每周 2 次' },
              { value: 3, label: '每周 3 次' },
            ].map((item) => (
              <label class="radio-choice">
                <input type="radio" name="days" value={item.value} checked={item.value === 2} />
                <span>{item.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>你有哪些器械？</legend>
          <div class="choice-grid">
            {[
              { value: 'home', label: '纯徒手' },
              { value: 'band', label: '弹力带' },
              { value: 'dumbbell', label: '哑铃' },
              { value: 'gym', label: '健身房' },
            ].map((item) => (
              <label class="radio-choice">
                <input
                  type="radio"
                  name="equipment"
                  value={item.value}
                  checked={item.value === 'home'}
                />
                <span>{item.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>每次能留多长时间？</legend>
          <div class="choice-grid three">
            {[20, 35, 50].map((minutes) => (
              <label class="radio-choice">
                <input type="radio" name="duration" value={minutes} checked={minutes === 35} />
                <span>{minutes} 分钟</span>
              </label>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="button form-action" style="margin-top:0">
          生成我的计划
          <Icon size={17} />
        </button>
        <p class="result-explainer">给零基础的一般入门模板。不是根据身体或病史制定的个体处方。</p>
        <p class="result-explainer" id="plan-pending" role="status" hidden>
          选项已修改，点击按钮更新计划。
        </p>
      </form>
      <div>
        <div class="planner-intro">
          <div>
            <h2>我的第一周</h2>
            <p id="plan-description">每周 2 次 · 纯徒手 · 每次约 35 分钟</p>
          </div>
          <span class="tag">入门模板</span>
        </div>
        <div id="plan-announcement" class="sr-only" role="status"></div>
        <div class="week-strip" id="week-strip" aria-label="一周训练安排">
          {weekdays.map((day, i) => {
            const session = initial.sessions.find((s) => s.day === i);
            return (
              <div class:list={['week-day', { training: !!session }]}>
                <span>{day}</span>
                <strong>{session ? `训练 ${session.label}` : '恢复 / 散步'}</strong>
              </div>
            );
          })}
        </div>
        <div class="notice" style="margin-bottom:22px">
          先预留约 5–8 分钟热身与动作准备。以下为正式组参考，每组动作可控并留有余力；组间可休息约
          60–120 秒，必要时更久。单侧动作每侧完成，死虫式可先做每侧 6–8 次。
        </div>
        <div id="workout-sessions">
          {initial.sessions.map((session) => (
            <section class="workout-session">
              <div class="session-title">
                <h3>
                  {weekdays[session.day]} / 全身训练 {session.label}
                </h3>
                <span>循序开始 · 先练动作</span>
              </div>
              {session.exercises.map((id) => {
                const exercise = movements.find((m) => m.id === id)!;
                return (
                  <div class="exercise-row">
                    <div>
                      <a href={`/movements/#${exercise.id}`}>{exercise.name} ↗</a>
                      <small>{exercise.cue}</small>
                    </div>
                    <div>
                      {initial.sets} 组 × {id === 'dead-bug' ? '每侧 6–8' : '8–12'} 次
                    </div>
                  </div>
                );
              })}
            </section>
          ))}
        </div>
        <div class="notice" id="equipment-notice">
          {initial.notice}
        </div>
        <p class="result-explainer" id="plan-progress">
          两次训练之间安排恢复；第二周可交换 A / B
          顺序。动作稳定、恢复正常后，再小幅增加次数或阻力。
        </p>
        <div class="plan-actions">
          <button id="download-plan" class="button secondary">
            <Icon name="download" size={17} />
            下载文字课表
          </button>
          <button id="copy-plan" class="button secondary">
            复制课表链接
          </button>
          <button id="print-plan" class="button secondary">
            打印计划
          </button>
          <a class="text-link" href="/tools/#rest-timer" style="margin-left:6px">
            组间计时 <Icon name="clock" size={17} />
          </a>
        </div>
        <p id="plan-share-status" class="result-explainer" role="status" hidden></p>
        <p class="result-explainer">
          模板由 Awesome Boji
          编辑整理。训练日可以整体平移，保留恢复间隔。时长包含准备和休息的粗略预留，实际用时因练习节奏而异。参考：
          <a
            href="https://acsm.org/education-resources/trending-topics-resources/physical-activity-guidelines/"
            target="_blank"
            rel="noopener noreferrer"
            style="text-decoration:underline"
          >
            ACSM 活动指南 ↗
          </a>
        </p>
        <noscript>
          <p class="notice">
            目前显示默认的每周两次徒手计划。启用 JavaScript 后可调整条件、下载与打印。
          </p>
        </noscript>
      </div>
    </div>
  </section>
  <script>
    import { generatePlan } from '../lib/fitness.mjs';
    import { movements } from '../data/movements';
    const weekdays = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
    const equipmentLabels: Record<string, string> = {
      home: '纯徒手',
      band: '弹力带',
      dumbbell: '哑铃',
      gym: '健身房',
    };
    let plan = generatePlan({ days: 2, equipment: 'home', duration: 35 });
    const form = document.querySelector<HTMLFormElement>('#plan-form')!;
    const sessionContainer = document.querySelector('#workout-sessions')!;
    const description = document.querySelector('#plan-description')!;
    const progress = document.querySelector('#plan-progress')!;
    const pending = document.querySelector<HTMLElement>('#plan-pending')!;
    function make(tag: string, className: string, text?: string) {
      const el = document.createElement(tag);
      el.className = className;
      if (text !== undefined) el.textContent = text;
      return el;
    }
    const exportButtons = ['download-plan', 'print-plan', 'copy-plan'].map(
      (id) => document.getElementById(id) as HTMLButtonElement,
    );
    const shareStatus = document.querySelector<HTMLElement>('#plan-share-status')!;
    function planUrl() {
      const url = new URL('/plan/', location.origin);
      url.search = new URLSearchParams({
        days: String(plan.days),
        equipment: plan.equipment,
        duration: String(plan.duration),
      }).toString();
      return url;
    }
    function render() {
      description.textContent = `每周 ${plan.days} 次 · ${equipmentLabels[plan.equipment]} · 每次约 ${plan.duration} 分钟`;
      const strip = document.querySelector('#week-strip')!;
      strip.replaceChildren();
      weekdays.forEach((day, index) => {
        const session = plan.sessions.find((s) => s.day === index);
        const div = make('div', `week-day${session ? ' training' : ''}`);
        div.append(
          make('span', '', day),
          make('strong', '', session ? `训练 ${session.label}` : '恢复 / 散步'),
        );
        strip.append(div);
      });
      sessionContainer.replaceChildren();
      plan.sessions.forEach((session) => {
        const section = make('section', 'workout-session');
        const heading = make('div', 'session-title');
        heading.append(
          make('h3', '', `${weekdays[session.day]} / 全身训练 ${session.label}`),
          make('span', '', '循序开始 · 先练动作'),
        );
        section.append(heading);
        session.exercises.forEach((id) => {
          const exercise = movements.find((m) => m.id === id)!;
          const row = make('div', 'exercise-row');
          const body = make('div', '');
          const link = document.createElement('a');
          link.href = `/movements/#${exercise.id}`;
          link.textContent = exercise.name + ' ↗';
          body.append(link, make('small', '', exercise.cue));
          row.append(
            body,
            make('div', '', `${plan.sets} 组 × ${id === 'dead-bug' ? '每侧 6–8' : '8–12'} 次`),
          );
          section.append(row);
        });
        sessionContainer.append(section);
      });
      document.querySelector('#equipment-notice')!.textContent = plan.notice;
      progress.textContent =
        plan.days === 3
          ? '三次训练按 A / B / A 交替，下一周从 B 开始。新手也可以先用两次版本，观察恢复后再增加频率。'
          : '两次训练之间安排恢复；第二周可交换 A / B 顺序。动作稳定、恢复正常后，再小幅增加次数或阻力。';
      pending.hidden = true;
      exportButtons.forEach((button) => (button.disabled = false));
      shareStatus.hidden = true;
      history.replaceState(null, '', planUrl());
      document.querySelector('#plan-announcement')!.textContent =
        `已生成${description.textContent}的入门课表。`;
    }
    form.addEventListener('change', () => {
      pending.hidden = false;
      exportButtons.forEach((button) => (button.disabled = true));
      shareStatus.hidden = true;
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      plan = generatePlan({
        days: Number(data.get('days')),
        equipment: String(data.get('equipment')),
        duration: Number(data.get('duration')),
      });
      render();
    });
    const params = new URLSearchParams(location.search);
    if (params.has('duration') || params.has('equipment') || params.has('days')) {
      try {
        plan = generatePlan({
          days: Number(params.get('days') || 2),
          equipment: params.get('equipment') || 'home',
          duration: Number(params.get('duration') || 35),
        });
        for (const [name, value] of Object.entries({
          days: plan.days,
          equipment: plan.equipment,
          duration: plan.duration,
        })) {
          const radio = Array.from(
            form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`),
          ).find((input) => input.value === String(value));
          if (radio) radio.checked = true;
        }
        render();
      } catch {
        /* Invalid share options keep the readable default plan. */
      }
    }
    document.querySelector('#copy-plan')!.addEventListener('click', async () => {
      const url = planUrl().href;
      try {
        await navigator.clipboard.writeText(url);
        shareStatus.textContent = '课表链接已复制。重新打开时，会保留天数、器械和时长选择。';
      } catch {
        shareStatus.textContent = `可以手动复制这份课表链接：${url}`;
      }
      shareStatus.hidden = false;
    });
    document.querySelector('#print-plan')!.addEventListener('click', () => window.print());
    document.querySelector('#download-plan')!.addEventListener('click', () => {
      const lines = [
        '# Awesome Boji · 我的第一周',
        String(description.textContent),
        '',
        '先预留约 5–8 分钟热身，选用轻阻力；组间休息约 60–120 秒，必要时更久。单侧动作每侧完成。',
        '',
      ];
      plan.sessions.forEach((session) => {
        lines.push(`## ${weekdays[session.day]} / 全身训练 ${session.label}`);
        session.exercises.forEach((id) => {
          const m = movements.find((x) => x.id === id)!;
          lines.push(
            `- ${m.name}：${plan.sets} 组 × ${id === 'dead-bug' ? '每侧 6–8' : '8–12'} 次。${m.cue}`,
          );
        });
        lines.push('');
      });
      lines.push(
        plan.notice,
        '',
        String(progress.textContent),
        '',
        '一般健康成年人入门参考，不是个体处方。出现关节锐痛或明显不适时停止练习。',
        `这份课表：${planUrl().href}`,
        '动作要点：https://lianboji.com/movements/',
        '来源与边界：https://lianboji.com/about/',
      );
      const blob = new Blob(['\uFEFF' + lines.join('\n')], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '练薄肌-第一周计划.txt';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  </script>
</Base>
