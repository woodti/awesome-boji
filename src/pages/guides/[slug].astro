---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { publishedAt, siteUrl } from '../../data/seo';
import { guides, sources } from '../../data/guides';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const related = [
  ...guides.filter((g) => g.slug !== guide.slug && g.category === guide.category),
  ...guides.filter((g) => g.slug !== guide.slug && g.category !== guide.category),
].slice(0, 3);
const modified = guide.updatedAt || guide.publishedAt || publishedAt;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.summary,
  datePublished: guide.publishedAt || publishedAt,
  dateModified: modified,
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: 'Awesome Boji', url: 'https://lianboji.com/about/' },
  publisher: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: `https://lianboji.com/guides/${guide.slug}/`,
  image: 'https://lianboji.com/images/og.png',
};
---

<Base title={`${guide.title}｜Awesome Boji`} description={guide.summary} schema={schema}>
  <div class="wrap">
    <header class="article-header">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>/</span>
        <a href="/guides/">薄肌指南</a>
        <span>/</span>
        <span>{guide.category}</span>
      </nav>

      <h1>{guide.title}</h1>
      <p>{guide.summary}</p>
      <div class="article-meta">
        <span>{guide.category}</span>
        <span>{guide.minutes} 分钟阅读</span>
        <a href="/about/">Awesome Boji 编辑整理</a>
        <time datetime={modified}>更新于 {modified.slice(0, 10).replaceAll('-', '.')}</time>
      </div>
    </header>
    <div class="content-layout section-sm" style="padding-top:0">
      <article>
        <div class="takeaway">
          <small>先记住这一句</small>
          <p>{guide.takeaway}</p>
        </div>
        <div class="article-body">
          {guide.sections.map((section, i) => (
            <section id={`section-${i + 1}`}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
        <div class="source-list" id="sources">
          <h2>参考来源与阅读边界</h2>
          {guide.sources.map((key) => (
            <a href={sources[key].url} target="_blank" rel="noopener noreferrer">
              {sources[key].title} ↗
            </a>
          ))}
          <p>
            以上来源支持相关背景知识；本站的具体训练安排、举例和解读由编辑整理，不是来源机构的个体训练处方。内容用于一般学习参考，不承诺体型变化或训练效果。
          </p>
        </div>
        <section aria-label="相关阅读" class="source-list">
          <h2>接着解决下一个问题</h2>
          {related.map((item) => (
            <a href={`/guides/${item.slug}/`}>
              {item.title} <Icon name="arrow" size={16} />
            </a>
          ))}
          <a href="/plan/">薄肌训练计划：按时间与器械生成课表</a>
          <a href="/tools/">热量与蛋白质计算工具</a>
        </section>
      </article>
      <aside class="article-sidebar" aria-label="文章目录">
        <h2>这篇读什么</h2>
        {guide.sections.map((section, i) => (
          <a href={`#section-${i + 1}`}>{section.title}</a>
        ))}
        <a href="#sources">参考来源</a>
        <a class="button" href="/plan/">
          把想法变成计划 <Icon size={16} />
        </a>
      </aside>
    </div>
  </div>
</Base>
