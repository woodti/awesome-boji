---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="页面没有找到｜练薄肌" noindex>
  <section class="wrap section" style="min-height:55vh">
    <div class="eyebrow">404 / TAKE ANOTHER STEP</div>
    <h1>
      这条路暂时没通。
      <br />
      换个方向，继续走。
    </h1>
    <p style="margin:25px 0">链接可能有误，或者页面已经调整。你的下一步，还可以从这里开始。</p>
    <div class="hero-actions">
      <a class="button" href="/">
        回到首页
        <Icon size={17} />
      </a>
      <a class="button secondary" href="/guides/">
        浏览薄肌指南
      </a>
    </div>
  </section>
</Base>
