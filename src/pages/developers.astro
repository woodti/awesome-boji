---
import Base from '../layouts/Base.astro';
import { formatTimer } from '../lib/fitness.mjs';
const scenarios = [
  {
    title: '只有二十分钟',
    text: '先做熟悉的三个动作。今天不需要一张两小时课表。',
    url: '/guides/after-work-twenty-minutes/',
    label: '看下班短练安排',
  },
  {
    title: '这一周在上线',
    text: '把训练缩小，保留恢复。空几天，不用周末拼命补回来。',
    url: '/guides/release-week/',
    label: '准备保底版本',
  },
  {
    title: '三餐主要靠外卖',
    text: '从你平常点的那份饭开始看，不用先把生活变成备餐工程。',
    url: '/guides/takeaway-lunch/',
    label: '看外卖饮食思路',
  },
  {
    title: '想把进步记下来',
    text: '动作、重量、次数和一句感受就够了，不给自己增加一套绩效。',
    url: '/guides/training-log/',
    label: '开始写训练日志',
  },
];
---

<Base
  title="程序员怎么练薄肌｜下班短练、久坐休息和外卖指南｜Awesome Boji"
  description="给程序员的薄肌行动路线：二十分钟短练、上线周保底、离屏休息、外卖与训练日志。选一个当前问题，开始一件小事。"
>
  <div class="wrap page-heading">
    <h1>
      不止写代码，
      <br />
      也练身材。
    </h1>
    <p>你不缺一套复杂的方法。先把训练放进真实的工作日，再慢慢改。</p>
  </div>
  <section class="wrap section-sm" style="padding-top:0">
    <div class="developer-hero">
      <div>
        <h2>
          先排两次，
          <br />
          别先排满。
        </h2>
        <p style="margin:25px 0">
          挑两个不连续的日子。器械和经验不足，就从小份、轻阻力和熟悉动作开始。下班安排得进去，比课表看起来很专业更要紧。
        </p>
        <a class="button" href="/plan/?days=2&equipment=home&duration=20">
          拿一份短课表
        </a>
      </div>
      <img
        src="/images/keyboard.webp"
        width="1400"
        height="788"
        alt="程序员熟悉的笔记本键盘与打字双手"
      />
    </div>
    <div class="developer-scenarios">
      {scenarios.map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
          <a class="text-link" href={item.url}>
            {item.label}
          </a>
        </article>
      ))}
    </div>
    <section id="desk-break" class="desk-break-panel" aria-labelledby="break-title">
      <div>
        <h2 id="break-title">
          先离屏，
          <br />
          休息五分钟。
        </h2>
        <p>在一个任务的自然间隙，起身走走，看看远处。不是另一组挑战，也不替代正式训练。</p>
        <ul class="break-instructions">
          <li>离开键盘，正常走一小段。</li>
          <li>换个姿势，接水或者去窗边。</li>
          <li>不做疼痛拉伸；不适持续时寻求评估。</li>
        </ul>
        <a class="text-link" href="/guides/desk-breaks/">
          读工位休息指南
        </a>
      </div>
      <div>
        <div class="break-clock" id="break-clock" role="timer" aria-label="离屏休息剩余时间">
          {formatTimer(300)}
        </div>
        <div class="break-actions">
          <button id="break-toggle" class="button">
            开始小休息
          </button>
          <button id="break-reset" class="button secondary">
            重新开始
          </button>
        </div>
        <p id="break-status" class="timer-status" role="status">
          准备好后，暂时离开屏幕。
        </p>
      </div>
    </section>
    <p class="result-explainer">
      五分钟是本站提供的方便选项，不代表适合所有人的最佳间隔或治疗方案。参考：
      <a
        href="https://www.osha.gov/etools/computer-workstations/work-process"
        target="_blank"
        rel="noopener noreferrer"
        style="text-decoration:underline"
      >
        OSHA 电脑工作站资料
      </a>
      。
    </p>
  </section>
  <section class="wrap section-sm">
    <h2>这不是另一份绩效。</h2>
    <p style="margin:25px 0;max-width:780px">
      这里没有连续打卡排名，没有虚构的逆袭照片，也不会替你规定“程序员应该长什么样”。先完成一次训练，吃一顿正常的饭，保留下一次还能开始的余量。
    </p>
    <a class="text-link" href="/start/">
      第一次练？走一遍入门路径
    </a>
  </section>
  <script>
    import { formatTimer } from '../lib/fitness.mjs';
    let remaining = 300,
      end = 0,
      active = false,
      interval: ReturnType<typeof setInterval> | undefined;
    const clock = document.querySelector('#break-clock')!;
    const toggle = document.querySelector<HTMLButtonElement>('#break-toggle')!;
    const status = document.querySelector('#break-status')!;
    function stop() {
      if (interval !== undefined) clearInterval(interval);
      interval = undefined;
      active = false;
    }
    function tick() {
      remaining = Math.max(0, Math.ceil((end - Date.now()) / 1000));
      clock.textContent = formatTimer(remaining);
      if (!remaining) {
        stop();
        toggle.textContent = '再休息一次';
        status.textContent = '这段休息结束了。按自己的节奏回到工作。';
      }
    }
    toggle.addEventListener('click', () => {
      if (active) {
        tick();
        stop();
        toggle.textContent = '继续休息';
        status.textContent = '已暂停。';
      } else {
        if (!remaining) remaining = 300;
        end = Date.now() + remaining * 1000;
        active = true;
        toggle.textContent = '暂停';
        status.textContent = '计时开始，起身走走吧。不需要一直盯着这里。';
        interval = setInterval(tick, 250);
        tick();
      }
    });
    document.querySelector('#break-reset')!.addEventListener('click', () => {
      stop();
      remaining = 300;
      clock.textContent = formatTimer(remaining);
      toggle.textContent = '开始小休息';
      status.textContent = '准备好后，暂时离开屏幕。';
    });
    document.addEventListener('visibilitychange', () => {
      if (active) tick();
    });
    window.addEventListener('pagehide', stop);
  </script>
</Base>
