---
import type { Guide } from '../data/guides';
interface Props {
  guide: Guide;
  visual?: boolean;
}
const { guide, visual = false } = Astro.props;
const photo =
  guide.category === '饮食恢复'
    ? 'meal'
    : guide.category === '程序员日常'
      ? 'keyboard'
      : guide.category === '理论观察'
        ? 'walk'
        : 'lift';
const alt: Record<string, string> = {
  meal: '鸡肉与鸡蛋盖饭的实拍',
  keyboard: '笔记本键盘上的双手',
  walk: '树木环绕的步行小路',
  lift: '手握哑铃的训练特写',
};
---

<a
  href={`/guides/${guide.slug}/`}
  class="guide-card"
  data-category={guide.category}
  data-search={`${guide.title} ${guide.summary} ${guide.category}`}
>
  {visual && (
    <img
      class="guide-photo"
      src={`/images/${photo}.webp`}
      width="800"
      height="500"
      alt={alt[photo]}
      loading="lazy"
    />
  )}
  <div class="guide-card-body">
    <div class="card-meta">
      <span>{guide.category}</span>
      <span>{guide.minutes} 分钟阅读</span>
    </div>
    <h3>{guide.title}</h3>
    <p>{guide.summary}</p>
  </div>
</a>
