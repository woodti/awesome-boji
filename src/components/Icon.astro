---
interface Props {
  name?: string;
  size?: number;
  class?: string;
}
const { name = 'arrow', size = 20, class: cls = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M5 12h14M12 5l7 7-7 7',
  diagonal: 'M6 18 18 6M6 6h12v12',
  search: 'M21 21l-5-5M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15',
  plus: 'M12 5v14M5 12h14',
  check: 'm5 12 4 4L19 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'm6 6 12 12M6 18 18 6',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 0-18 0 9 9 0 0 0 18 0',
  barbell: 'M7 12h10M4 8v8M7 6v12M17 6v12M20 8v8',
  book: 'M12 5v15M3 4c4-1 6 0 9 1 3-1 5-2 9-1v14c-4-1-6 0-9 2-3-2-5-3-9-2z',
  calculator: 'M6 3h12v18H6zM9 7h6M9 11h1M14 11h1M9 15h1M14 15h1M9 18h1M14 18h1',
  sun: 'M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1 1M18 18l1 1M5 19l1-1M18 6l1-1M16 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0',
  download: 'M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
>
  <path d={paths[name] || paths.arrow} />
</svg>
