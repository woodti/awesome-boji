---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { guides } from '../data/guides';
import { pageNames, siteName, siteUrl, verification } from '../data/seo';
interface Props {
  title?: string;
  bodyClass?: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}
const {
  title = 'Awesome Boji｜薄肌指南',
  description = '从薄肌是什么，到今天怎么练。练薄肌提供有来源的入门指南、训练计划生成器、动作库和营养计算工具，陪你建立能坚持的训练习惯。',
  noindex = false,
  bodyClass = '',
  schema,
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const article = schema?.['@type'] === 'Article';
const crumbs =
  pathname === '/' || noindex
    ? []
    : [
        { name: '首页', path: '/' },
        ...(pathname.startsWith('/guides/') && pathname !== '/guides/'
          ? [{ name: '薄肌文章', path: '/guides/' }]
          : []),
        { name: pageNames[pathname] || title.split('｜')[0], path: pathname },
      ];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      url: `${siteUrl}/`,
      sameAs: ['https://github.com/woodti/awesome-boji'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      alternateName: '薄肌指南',
      url: `${siteUrl}/`,
      inLanguage: 'zh-CN',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: 'zh-CN',
      isPartOf: { '@id': `${siteUrl}/#website` },
      ...(crumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(crumbs.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: crumbs.map((crumb, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: crumb.name,
              item: new URL(crumb.path, siteUrl).href,
            })),
          },
        ]
      : []),
    ...(schema ? [schema] : []),
  ],
};
const navigation = [
  { href: '/developers/', label: '程序员' },
  { href: '/guides/', label: '指南' },
  { href: '/plan/', label: '课表' },
  { href: '/tools/', label: '工具' },
  { href: '/theory/', label: '薄肌理论' },
];
const searchItems = [
  ...guides.map((g) => ({
    title: g.title,
    description: g.summary,
    category: g.category,
    url: `/guides/${g.slug}/`,
  })),
  {
    title: '训练计划生成器',
    description: '根据时间与器械条件选择入门课表',
    category: '工具',
    url: '/plan/',
  },
  {
    title: '热量与蛋白质计算器',
    description: '估算每日消耗与蛋白质参考范围',
    category: '工具',
    url: '/tools/',
  },
  {
    title: '动作库',
    description: '查看动作要点与降低难度的方法',
    category: '动作',
    url: '/movements/',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.baidu && <meta name="baidu-site-verification" content={verification.baidu} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Awesome Boji" />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site)} />
    <meta property="og:image:alt" content="Awesome Boji 薄肌指南：写代码，也练身材" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href="/" aria-label="Awesome Boji 首页">
          <img src="/favicon.svg" width="34" height="34" alt="" />
          <span>
            Awesome Boji<small>薄肌指南</small>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {navigation.map((item) => (
            <a
              class:list={[{ active: pathname.startsWith(item.href) }]}
              href={item.href}
              aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button class="icon-button search-open" aria-label="搜索文章和工具">
            <Icon name="search" />
            <kbd>/</kbd>
          </button>
          <a href="/plan/" class="button compact header-cta">
            开始练 <Icon name="diagonal" size={15} />
          </a>
          <button
            class="icon-button mobile-menu"
            aria-label="打开导航"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="移动导航" hidden>
        {navigation.map((item) => (
          <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
            <Icon />
          </a>
        ))}
        <a href="/movements/">
          动作库
          <Icon />
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-content">
        <div>
          <h2>给身体，也留点时间。</h2>
          <p>写代码，也练身材。按自己的节奏来。</p>
          <a class="button" href="/plan/">
            拿一份课表
          </a>
        </div>
        <nav class="footer-nav" aria-label="页脚导航">
          <a href="/start/">从零开始</a>
          <a href="/about/">关于本站</a>
          <a href="/privacy/">隐私说明</a>
          <a href="/credits/">图片署名</a>
          <a
            href="https://github.com/woodti/awesome-boji"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
      <div class="wrap footer-note">
        <div class="footer-copy">
          <p>独立内容项目，面向一般健康成年人。按自己的情况调整训练与饮食。</p>
          <p>
            摄影来自公开资料库，非站长或用户实录。<a href="/credits/">作者与许可</a>
          </p>
        </div>
        <span class="footer-copyright">© {new Date().getFullYear()} Awesome Boji</span>
      </div>
    </footer>
    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
      <div class="search-heading">
        <h2 id="search-title">找到你的下一步</h2>
        <button class="icon-button search-close" aria-label="关闭搜索">
          <Icon name="close" />
        </button>
      </div>
      <label class="search-field">
        <Icon name="search" />
        <span class="sr-only">搜索关键词</span>
        <input
          id="global-search"
          type="search"
          placeholder="试试“训练计划”“蛋白质”…"
          autocomplete="off"
        />
      </label>
      <div id="search-results" class="search-results" aria-live="polite"></div>
      <p class="search-hint">搜索站内指南与工具 · 按 Esc 关闭</p>
    </dialog>
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target;
                const row = el.matches('.reading-list > a');
                el.classList.add(row ? 'row-enter' : 'scroll-enter');
                observer.unobserve(el);
              }
            }
          },
          { threshold: 0.12 },
        );
        document
          .querySelectorAll(
            '.scene-intro > *, .story-chapter > *, .reading-list > a, .theory-note-inner > *, .tool-link-list > a, .home-faq > h2',
          )
          .forEach((el) => observer.observe(el));
      }
    </script>
    <script define:vars={{ searchItems }}>
      const dialog = document.querySelector('#search-dialog');
      const input = document.querySelector('#global-search');
      const results = document.querySelector('#search-results');
      function renderSearch() {
        const query = input.value.trim().toLowerCase();
        const items = searchItems
          .filter((x) => `${x.title} ${x.description} ${x.category}`.toLowerCase().includes(query))
          .slice(0, 8);
        results.replaceChildren();
        if (!items.length) {
          const p = document.createElement('p');
          p.className = 'empty-state';
          p.textContent = '暂时没有找到，换一个关键词试试。';
          results.append(p);
        }
        items.forEach((item) => {
          const a = document.createElement('a');
          a.href = item.url;
          const category = document.createElement('small');
          category.textContent = item.category;
          const title = document.createElement('strong');
          title.textContent = item.title;
          a.append(category, title);
          results.append(a);
        });
      }
      document.querySelectorAll('.search-open').forEach((button) =>
        button.addEventListener('click', () => {
          renderSearch();
          dialog.showModal();
          input.focus();
        }),
      );
      document.querySelector('.search-close').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          const r = dialog.getBoundingClientRect();
          if (
            event.clientX < r.left ||
            event.clientX > r.right ||
            event.clientY < r.top ||
            event.clientY > r.bottom
          )
            dialog.close();
        }
      });
      input.addEventListener('input', renderSearch);
      document.addEventListener('keydown', (event) => {
        if (
          event.key === '/' &&
          !dialog.open &&
          !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName) &&
          !document.activeElement.isContentEditable
        ) {
          event.preventDefault();
          renderSearch();
          dialog.showModal();
          input.focus();
        }
      });
      const menu = document.querySelector('.mobile-menu');
      const mobile = document.querySelector('#mobile-nav');
      menu.addEventListener('click', () => {
        const expanded = menu.getAttribute('aria-expanded') === 'true';
        menu.setAttribute('aria-expanded', String(!expanded));
        menu.setAttribute('aria-label', expanded ? '打开导航' : '关闭导航');
        mobile.hidden = expanded;
      });
    </script>
  </body>
</html>
